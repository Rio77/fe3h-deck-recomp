#!/bin/sh
# Keep resources beside the executable; game files stay in the user's data root.
HERE=$(dirname "$(readlink -f "$0")")
PRODUCT=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
if [ "${FE3H_DECK_PROFILE:-1}" != 0 ]; then
    case "$PRODUCT" in Jupiter|Galileo)
        export FE3H_HANDHELD="${FE3H_HANDHELD:-0}"
        export FE3H_MANAGED_HEAP="${FE3H_MANAGED_HEAP:-1}"
        export FE3H_NATIVE_HALF="${FE3H_NATIVE_HALF:-1}"
        export FE3H_SPARSE_LOCAL="${FE3H_SPARSE_LOCAL:-1}"
        export FE3H_TIMED_SYNC="${FE3H_TIMED_SYNC:-1}"
        export FE3H_DOCK_TARGETS="${FE3H_DOCK_TARGETS:-1}"
        export FE3H_COMPUTE_SCF="${FE3H_COMPUTE_SCF:-1}"
        export FE3H_LIGHTING_SCF="${FE3H_LIGHTING_SCF:-1}"
        export FE3H_EFFECT_SCALE_FIX="${FE3H_EFFECT_SCALE_FIX:-0}"
        export FE3H_LIMITER_MARGIN_US="${FE3H_LIMITER_MARGIN_US:-1000}"
        export FE3H_WARM_PROFILE="${FE3H_WARM_PROFILE:-1}"
        export SDL_AUDIO_DRIVER="${SDL_AUDIO_DRIVER:-pulseaudio}"
    esac
fi
if [ "${FE3H_ALLOW_FOSSILIZE:-0}" != 1 ]; then
    export DISABLE_VK_LAYER_VALVE_steam_fossilize_1="${DISABLE_VK_LAYER_VALVE_steam_fossilize_1:-1}"
fi
if [ "${FE3H_MESA_CACHE_OVERRIDE:-1}" != 0 ] && [ "${MESA_SHADER_CACHE_DISABLE:-0}" != 1 ] && [ "${MESA_SHADER_CACHE_DISABLE:-0}" != true ]; then
    unset MESA_GLSL_CACHE_DIR MESA_DISK_CACHE_READ_ONLY_FOZ_DBS \
          MESA_DISK_CACHE_READ_ONLY_FOZ_DBS_DYNAMIC_LIST MESA_DISK_CACHE_COMBINE_RW_WITH_RO_FOZ
    DATA_ROOT="${LARECOMP_DATA_ROOT:-$PWD}"
    mkdir -p "$DATA_ROOT/cache/mesa_cache" 2>/dev/null || true
    export MESA_SHADER_CACHE_DIR="$DATA_ROOT/cache/mesa_cache"
    export MESA_DISK_CACHE_SINGLE_FILE=0
    export MESA_SHADER_CACHE_MAX_SIZE="${MESA_SHADER_CACHE_MAX_SIZE:-2G}"
fi
exec "$HERE/usr/bin/fe3hrecomp" "$@"
